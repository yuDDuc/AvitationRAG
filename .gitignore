# Project Specific Data
# Ignore vector database and uploaded documents to prevent committing large files
# and sensitive data.
backend/data/docs/*
!backend/data/docs/.keep
backend/data/vector_db/*
!backend/data/vector_db/.keep
backend/data/semantic_cache/*
!backend/data/semantic_cache/.keep
backend/data/quizzes/*
!backend/data/quizzes/.keep
backend/data/document_metadata.json
/donttouch

