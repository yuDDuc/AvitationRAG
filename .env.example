# Aviation RAG Backend Configuration

# Gemini API Key (Lấy tại: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=ENTER YOUR API KEY HERE

# Tên model LLM của Google (ví dụ: gemini-flash-latest, gemma-4-31b-it)
GOOGLE_LLM_MODEL=gemma-4-31b-it

# (Tùy chọn) OpenAI API Key nếu sau này bạn muốn đổi model
# OPENAI_API_KEY=your_openai_api_key_here

# Cấu hình môi trường
ENVIRONMENT=development
PORT=8000
